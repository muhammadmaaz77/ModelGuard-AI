: 40, borderRadius: 'var(--radius-sm)',\r\n                                                background: `${item.color}15`,\r\n                                                display: 'flex', alignItems: 'center', justifyContent: 'center',\r\n                                            }}>\r\n                                                {item.color === '#22c55e'\r\n                                                    ? <ShieldCheck size={20} color={item.color} />\r\n                                                    : <AlertTriangle size={20} color={item.color} />\r\n                                                }\r\n                                            </div>\r\n                                            <div>\r\n                                                <div style={{\r\n                                                    fontFamily: 'var(--font-body)',\r\n                                                    fontSize: 'var(--body-md)',\r\n                                                    fontWeight: 600,\r\n                                                    color: 'var(--on-surface)',\r\n                                                }}>\r\n                                                    {item.label}\r\n                                                </div>\r\n                                                <div style={{\r\n                                                    fontFamily: 'var(--font-label)',\r\n                                                    fontSize: 'var(--label-sm)',\r\n                                                    color: 'var(--outline)',\r\n                                                    letterSpacing: '0.03em',\r\n                                                    marginTop: '2px',\r\n                                                }}>\r\n                                                    {item.count} customers\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                        <div style={{\r\n                                            fontFamily: 'var(--font-display)',\r\n                                            fontSize: 'var(--headline-sm)',\r\n                                            fontWeight: 700,\r\n                                            color: item.color,\r\n                                            textShadow: `0 0 20px ${item.color}22`,\r\n                                        }}>\r\n                                            {item.pct}%\r\n                                        </div>\r\n                                    </div>\r\n                                ))}\r\n\r\n                                {/* Visual bar comparison */}\r\n                                <div style={{ marginTop: '4px' }}>\r\n                                    <div style={{\r\n                                        height: '16px',\r\n                                        borderRadius: 'var(--radius-full)',\r\n                                        overflow: 'hidden',\r\n                                        display: 'flex',\r\n                                        background: 'var(--surface-container-high)',\r\n                                    }}>\r\n                                        <div style={{\r\n                                            width: `${(stays / total) * 100}%`,\r\n                                            background: 'linear-gradient(90deg, #22c55e, #4ade80)',\r\n                                            borderRadius: 'var(--radius-full) 0 0 var(--radius-full)',\r\n                                            transition: 'width 1.2s cubic-bezier(0.22, 0.61, 0.36, 1)',\r\n                                        }} />\r\n                                        <div style={{\r\n                                            width: `${(churns / total) * 100}%`,\r\n                       